<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/min_touch_target"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_m"
    android:paddingTop="@dimen/spacing_s"
    android:paddingEnd="@dimen/spacing_s"
    android:paddingBottom="@dimen/spacing_s">

    <ImageView
        android:id="@+id/cityLocationIcon"
        android:layout_width="@dimen/icon_size_m"
        android:layout_height="@dimen/icon_size_m"
        android:layout_marginEnd="@dimen/spacing_m"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_location_pin"
        app:tint="@color/fomo_accent_electric_violet" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cityNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fomo_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Paris" />

        <TextView
            android:id="@+id/cityRegionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/fomo_text_secondary"
            android:textSize="13sp"
            tools:text="Ile-de-France, France" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_favorite_star"
        app:srcCompat="@drawable/ic_star_outline" />

</LinearLayout>

