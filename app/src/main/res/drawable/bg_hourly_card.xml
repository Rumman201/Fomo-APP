<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/fomo_surface_glass">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/fomo_surface_card_selected" />
                    <corners android:radius="@dimen/corner_radius_hourly" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/fomo_accent_gold" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/fomo_surface_card" />
                    <corners android:radius="@dimen/corner_radius_hourly" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/fomo_surface_card_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
